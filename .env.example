# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Convex
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=  # optional for admin actions

# Redis (local)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# OAuth (Google)
# Authorized redirect URI: {BACKEND_URL}/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth (GitHub)
# Authorization callback URL: {BACKEND_URL}/accounts/github/login/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Backend public origin (must match OAuth redirect URIs)
BACKEND_URL=http://127.0.0.1:8000

# Frontend origin (CORS + OAuth return to /auth/callback)
FRONTEND_URL=http://localhost:3000
